generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Auth.js tables for magic link verification
model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// UNIFIED USER MODEL
// ============================================================================

enum UserRole {
  dev
  admin
  manager
  member
}

model User {
  email     String   @id @db.VarChar(255)
  uid       String   @unique @default(uuid()) @db.VarChar(255)
  name      String   @db.VarChar(255)
  role      UserRole @default(member)
  profile   Json?    @db.Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  managerProfile    ManagerProfile?
  activityManagers  ActivityManager[]
  activityUpdates   ActivityUpdate[]
  waivers           UserWaiver[]
  registrations     Registration[]
  flags             UserFlag[]          @relation("flaggedUser")
  issuedFlags       UserFlag[]          @relation("flagIssuer")
  promotionRequests PromotionRequest[]

  @@index([role])
  @@map("users")
}

model ManagerProfile {
  userEmail   String    @id @map("user_email") @db.VarChar(255)
  tag         String    @unique @db.VarChar(255)
  intern      Boolean   @default(true)
  internSince DateTime? @map("intern_since")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("manager_profiles")
}

// ============================================================================
// FLAG / BAN SYSTEM
// ============================================================================

enum FlagType {
  yellow
  red
}

model UserFlag {
  id         String   @id @default(uuid()) @db.VarChar(255)
  userEmail  String   @map("user_email") @db.VarChar(255)
  activityId String   @map("activity_id") @db.VarChar(255)
  flagType   FlagType @map("flag_type")
  reason     String?  @db.Text
  issuedBy   String   @map("issued_by") @db.VarChar(255)
  issuedAt   DateTime @default(now()) @map("issued_at")

  user     User     @relation("flaggedUser", fields: [userEmail], references: [email], onDelete: Cascade)
  issuer   User     @relation("flagIssuer", fields: [issuedBy], references: [email], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userEmail])
  @@index([issuedAt])
  @@map("user_flags")
}

// ============================================================================
// WAIVERS
// ============================================================================

enum WaiverStatus {
  approved
  expiring
  expired
}

model UserWaiver {
  fileId        String       @id @map("file_id") @db.VarChar(255)
  userEmail     String       @map("user_email") @db.VarChar(255)
  signedAt      DateTime     @default(now()) @map("signed_at")
  status        WaiverStatus @default(approved)
  signedVersion Int?         @map("signed_version")
  signedName    String?      @map("signed_name") @db.VarChar(255)

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@map("user_waivers")
}

// ============================================================================
// ACTIVITIES
// ============================================================================

enum ActivityStatus {
  open
  closed
  completed
  cancelled
}

model Activity {
  id                  String         @id @default(uuid()) @db.VarChar(255)
  title               String         @db.VarChar(500)
  description         String         @db.Text
  coverImgId          String         @map("cover_img_id") @db.VarChar(255)
  deadline            DateTime
  date                DateTime
  capacity            Int
  maximumRegistration Int?           @map("maximum_registration")
  metadata            Json?          @db.Json
  status              ActivityStatus @default(open)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  activityManagers ActivityManager[]
  registrations    Registration[]
  updates          ActivityUpdate[]
  flags            UserFlag[]

  @@index([status])
  @@index([deadline])
  @@index([date])
  @@map("activities")
}

// ============================================================================
// ACTIVITY RELATIONSHIPS
// ============================================================================

enum ActivityManagerRole {
  manager
  comanager
}

enum ActivityManagerStatus {
  invited
  confirmed
  declined
}

model ActivityManager {
  activityId  String                @map("activity_id") @db.VarChar(255)
  userEmail   String                @map("user_email") @db.VarChar(255)
  role        ActivityManagerRole
  status      ActivityManagerStatus @default(confirmed)
  invitedAt   DateTime              @default(now()) @map("invited_at")
  respondedAt DateTime?             @map("responded_at")
  token       String?               @unique @db.VarChar(255)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([role])
  @@index([status])
  @@map("activity_managers")
}

enum RegistrationStatus {
  registered
  registration_confirmed
  attended
  absent
}

model Registration {
  activityId   String             @map("activity_id") @db.VarChar(255)
  userEmail    String             @map("user_email") @db.VarChar(255)
  status       RegistrationStatus @default(registered)
  registeredAt DateTime           @default(now()) @map("registered_at")
  confirmedAt  DateTime?          @map("confirmed_at")
  notes        String?            @db.Text
  formData     Json?              @map("form_data") @db.Json
  pendingFlag       String?            @map("pending_flag") @db.VarChar(10)
  pendingFlagReason String?            @map("pending_flag_reason") @db.Text

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([status])
  @@map("registrations")
}

model ActivityUpdate {
  id         String   @id @default(uuid()) @db.VarChar(255)
  activityId String   @map("activity_id") @db.VarChar(255)
  title      String   @db.VarChar(500)
  content    String?  @db.Text
  postedBy   String   @map("posted_by") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [postedBy], references: [email])

  @@index([activityId])
  @@index([createdAt])
  @@map("activity_updates")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

enum PromotionType {
  member_to_intern
  intern_to_qualified
}

enum PromotionStatus {
  pending
  pending_admin_review
  approved
  rejected
  expired
}

model PromotionRequest {
  id              String          @id @default(uuid()) @db.VarChar(255)
  userEmail       String          @map("user_email") @db.VarChar(255)
  type            PromotionType
  status          PromotionStatus @default(pending)
  applicationText String?         @map("application_text") @db.Text
  requestedAt     DateTime        @default(now()) @map("requested_at")
  expiresAt       DateTime        @map("expires_at")
  resolvedAt      DateTime?       @map("resolved_at")

  user  User              @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  votes PromotionVote[]

  @@index([userEmail])
  @@index([status])
  @@index([expiresAt])
  @@map("promotion_requests")
}

model PromotionVote {
  id         String   @id @default(uuid()) @db.VarChar(255)
  requestId  String   @map("request_id") @db.VarChar(255)
  voterEmail String   @map("voter_email") @db.VarChar(255)
  approved   Boolean?
  reason     String?  @db.Text
  votedAt    DateTime? @map("voted_at")
  token      String   @unique @db.VarChar(255)

  request PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, voterEmail])
  @@index([requestId])
  @@index([token])
  @@map("promotion_votes")
}

// ============================================================================
// SYSTEM
// ============================================================================

enum AuditEntityType {
  user
  activity
  registration
}

enum AuditAction {
  create
  update
  delete
  status_change
}

model AuditLog {
  id          String          @id @default(uuid()) @db.VarChar(255)
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id") @db.VarChar(255)
  action      AuditAction
  performedBy String?         @map("performed_by") @db.VarChar(255)
  oldValues   Json?           @map("old_values")
  newValues   Json?           @map("new_values")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model AppSettings {
  key   String @id @db.VarChar(255)
  value String @db.Text

  @@map("app_settings")
}
