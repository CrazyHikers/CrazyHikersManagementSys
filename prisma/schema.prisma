generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js tables for magic link verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// UNIFIED USER MODEL
// ============================================================================

enum UserRole {
  dev
  admin
  manager
  member
}

model User {
  email             String   @id
  uid               String   @unique @default(uuid())
  name              String
  role              UserRole @default(member)
  passwordHash      String?  @map("password_hash")
  profile           Json?    @db.JsonB
  notificationPrefs Json?    @map("notification_prefs") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  managerProfile        ManagerProfile?
  activityManagers      ActivityManager[]
  activityUpdates       ActivityUpdate[]
  waivers               UserWaiver[]
  registrations         Registration[]
  flags                 UserFlag[]             @relation("flaggedUser")
  issuedFlags           UserFlag[]             @relation("flagIssuer")
  invalidatedFlags      UserFlag[]             @relation("flagInvalidator")
  promotionRequests     PromotionRequest[]
  registrationProposals RegistrationProposal[] @relation("registrationProposer")
  webPushSubscriptions  WebPushSubscription[]
  telegramSubscription  TelegramSubscription?
  telegramLinkTokens    TelegramLinkToken[]
  discordSubscription   DiscordSubscription?
  discordLinkTokens     DiscordLinkToken[]
  internResources       InternResource[]
  createdPolls          Poll[]                 @relation("PollCreator")
  pollParticipations    PollParticipation[]    @relation("PollVoter")

  @@index([role])
  @@map("users")
}

model ManagerProfile {
  userEmail   String    @id @map("user_email")
  tag         String    @unique
  intern      Boolean   @default(true)
  internSince DateTime? @map("intern_since")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("manager_profiles")
}

// ============================================================================
// FLAG / BAN SYSTEM
// ============================================================================

enum FlagType {
  yellow
  red
}

model UserFlag {
  id            String    @id @default(uuid())
  userEmail     String    @map("user_email")
  activityId    String    @map("activity_id")
  flagType      FlagType  @map("flag_type")
  reason        String?
  issuedBy      String    @map("issued_by")
  invalidated   Boolean   @default(false)
  invalidatedBy String?   @map("invalidated_by")
  invalidatedAt DateTime? @map("invalidated_at")

  user        User     @relation("flaggedUser", fields: [userEmail], references: [email], onDelete: Cascade)
  issuer      User     @relation("flagIssuer", fields: [issuedBy], references: [email], onDelete: Cascade)
  invalidator User?    @relation("flagInvalidator", fields: [invalidatedBy], references: [email], onDelete: SetNull)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userEmail])
  @@index([activityId])
  @@map("user_flags")
}

// ============================================================================
// WAIVERS
// ============================================================================

enum WaiverStatus {
  approved
  expired
}

model UserWaiver {
  fileId        String       @id @map("file_id")
  userEmail     String       @map("user_email")
  signedAt      DateTime     @default(now()) @map("signed_at")
  status        WaiverStatus @default(approved)
  signedVersion Int?         @map("signed_version")
  signedName    String?      @map("signed_name")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@map("user_waivers")
}

model WaiverTemplate {
  id         String   @id @default(uuid())
  version    Int      @unique @default(autoincrement())
  r2Key      String   @map("r2_key")
  filename   String
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy String   @map("uploaded_by")

  @@map("waiver_templates")
}

// ============================================================================
// ACTIVITIES
// ============================================================================

enum ActivityStatus {
  open
  completed
  cancelled
}

model Activity {
  id                     String         @id @default(uuid())
  title                  String
  description            String
  coverImgId             String         @map("cover_img_id")
  homepageThumbnailImgId String?        @map("homepage_thumbnail_img_id")
  registrationHeroImgId  String?        @map("registration_hero_img_id")
  deadline               DateTime
  date                   DateTime
  capacity               Int
  maximumRegistration    Int?           @map("maximum_registration")
  metadata               Json?          @db.JsonB
  status                 ActivityStatus @default(open)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at")

  activityManagers ActivityManager[]
  registrations    Registration[]
  updates          ActivityUpdate[]
  flags            UserFlag[]

  @@index([status])
  @@index([deadline])
  @@index([date])
  @@map("activities")
}

// ============================================================================
// ACTIVITY RELATIONSHIPS
// ============================================================================

enum ActivityManagerRole {
  manager
  comanager
}

enum ActivityManagerStatus {
  invited
  confirmed
  declined
}

model ActivityManager {
  activityId  String                @map("activity_id")
  userEmail   String                @map("user_email")
  role        ActivityManagerRole
  status      ActivityManagerStatus @default(confirmed)
  invitedAt   DateTime              @default(now()) @map("invited_at")
  respondedAt DateTime?             @map("responded_at")
  token       String?               @unique

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([role])
  @@index([status])
  @@map("activity_managers")
}

enum RegistrationStatus {
  registered
  registration_confirmed
  attended
  absent
}

model Registration {
  activityId        String             @map("activity_id")
  userEmail         String             @map("user_email")
  status            RegistrationStatus @default(registered)
  registeredAt      DateTime           @default(now()) @map("registered_at")
  confirmedAt       DateTime?          @map("confirmed_at")
  notes             String?
  formData          Json?              @map("form_data") @db.JsonB
  pendingFlag       String?            @map("pending_flag")
  pendingFlagReason String?            @map("pending_flag_reason")

  activity  Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  proposals RegistrationProposal[]

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([status])
  @@map("registrations")
}

// Soft endorsement that an intern manager added to a member's pending
// registration. Multiple interns may propose the same member; the row
// keyed by (activityId, userEmail, proposerEmail) represents one such
// endorsement. Cleared automatically when the registration is confirmed.
model RegistrationProposal {
  activityId    String   @map("activity_id")
  userEmail     String   @map("user_email")
  proposerEmail String   @map("proposer_email")
  proposedAt    DateTime @default(now()) @map("proposed_at")

  registration Registration @relation(fields: [activityId, userEmail], references: [activityId, userEmail], onDelete: Cascade)
  proposer     User         @relation("registrationProposer", fields: [proposerEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail, proposerEmail])
  @@index([activityId, userEmail])
  @@index([proposerEmail])
  @@map("registration_proposals")
}

model ActivityUpdate {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  title      String
  content    String?
  postedBy   String   @map("posted_by")
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [postedBy], references: [email])

  @@index([activityId])
  @@index([createdAt])
  @@map("activity_updates")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

enum PromotionType {
  member_to_intern
  intern_to_qualified
}

enum PromotionStatus {
  pending
  pending_admin_review
  approved
  rejected
  expired
}

model PromotionRequest {
  id              String          @id @default(uuid())
  userEmail       String          @map("user_email")
  type            PromotionType
  status          PromotionStatus @default(pending)
  applicationText String?         @map("application_text")
  requestedAt     DateTime        @default(now()) @map("requested_at")
  expiresAt       DateTime        @map("expires_at")
  resolvedAt      DateTime?       @map("resolved_at")

  user  User            @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  votes PromotionVote[]

  @@index([userEmail])
  @@index([status])
  @@index([expiresAt])
  @@map("promotion_requests")
}

model PromotionVote {
  id         String    @id @default(uuid())
  requestId  String    @map("request_id")
  voterEmail String    @map("voter_email")
  approved   Boolean?
  reason     String?
  votedAt    DateTime? @map("voted_at")
  token      String    @unique

  request PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, voterEmail])
  @@index([requestId])
  @@index([token])
  @@map("promotion_votes")
}

// ============================================================================
// MEMBER POLLS
// ============================================================================

enum PollScope {
  member_plus
  manager_plus
  admin
}

enum PollStatus {
  draft
  open
  closed
}

model Poll {
  id             String     @id @default(uuid())
  title          String
  description    String     @default("")
  scope          PollScope
  status         PollStatus @default(draft)
  allowOther     Boolean    @default(false) @map("allow_other")
  deadline       DateTime
  createdByEmail String     @map("created_by_email")
  publishedAt    DateTime?  @map("published_at")
  closedAt       DateTime?  @map("closed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  creator        User                @relation("PollCreator", fields: [createdByEmail], references: [email], onDelete: Restrict)
  options        PollOption[]
  participations PollParticipation[]
  ballots        PollBallot[]

  @@index([scope])
  @@index([status])
  @@index([deadline])
  @@index([createdByEmail])
  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid())
  pollId    String @map("poll_id")
  label     String
  sortOrder Int    @map("sort_order")

  poll    Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  ballots PollBallot[]

  @@unique([pollId, sortOrder])
  @@index([pollId])
  @@map("poll_options")
}

model PollParticipation {
  pollId     String   @map("poll_id")
  voterEmail String   @map("voter_email")
  votedAt    DateTime @default(now()) @map("voted_at")

  poll  Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voter User @relation("PollVoter", fields: [voterEmail], references: [email], onDelete: Cascade)

  @@id([pollId, voterEmail])
  @@index([voterEmail])
  @@index([votedAt])
  @@map("poll_participations")
}

model PollBallot {
  id        String  @id @default(uuid())
  pollId    String  @map("poll_id")
  optionId  String? @map("option_id")
  otherText String? @map("other_text")

  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([pollId])
  @@index([optionId])
  @@map("poll_ballots")
}

// ============================================================================
// SYSTEM
// ============================================================================

enum AuditEntityType {
  user
  activity
  registration
  poll
}

enum AuditAction {
  create
  update
  delete
  status_change
}

model AuditLog {
  id          String          @id @default(uuid())
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  action      AuditAction
  performedBy String?         @map("performed_by")
  oldValues   Json?           @map("old_values") @db.JsonB
  newValues   Json?           @map("new_values") @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model AppSettings {
  key   String @id
  value String

  @@map("app_settings")
}

// ============================================================================
// PUSH NOTIFICATIONS
// ============================================================================

// One row per browser/device. Other push channels (Discord, WeChat, etc.)
// will live in their own tables since their identity model and stored fields
// are different from Web Push's (endpoint + p256dh + auth).
model WebPushSubscription {
  id         String    @id @default(uuid())
  userEmail  String    @map("user_email")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@map("web_push_subscriptions")
}

// One linked Telegram account per user. chatId is the user's Telegram chat
// (we DM the bot, so chat = user-bot DM); both fields are unique so neither
// the user nor a Telegram account can link twice.
model TelegramSubscription {
  id        String   @id @default(uuid())
  userEmail String   @unique @map("user_email")
  chatId    String   @unique @map("chat_id")
  username  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("telegram_subscriptions")
}

// Short-lived one-time tokens for the deep-link onboarding flow:
// website generates a token, user opens t.me/<bot>?start=<token>,
// bot's /start handler looks up the row and binds the chatId to userEmail.
model TelegramLinkToken {
  id        String    @id @default(uuid())
  userEmail String    @map("user_email")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@index([expiresAt])
  @@map("telegram_link_tokens")
}

// One linked Discord account per user. Bot can DM via the cached
// dmChannelId (avoids re-creating the DM channel on every send).
model DiscordSubscription {
  id            String   @id @default(uuid())
  userEmail     String   @unique @map("user_email")
  discordUserId String   @unique @map("discord_user_id")
  username      String?
  dmChannelId   String?  @map("dm_channel_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("discord_subscriptions")
}

// State tokens for the OAuth linking flow. The token id is sent as the
// `state` parameter on the Discord redirect; the callback looks it up,
// verifies ownership, and consumes it.
model DiscordLinkToken {
  id        String    @id @default(uuid())
  userEmail String    @map("user_email")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@index([expiresAt])
  @@map("discord_link_tokens")
}

// ============================================================================
// INTERN RESOURCES
// ============================================================================

enum InternResourceKind {
  DOCUMENT
  VIDEO
}

// Files uploaded by admins for intern managers to download (training
// materials, guides, recorded sessions). Visible to admins and any
// manager whose ManagerProfile.intern is true.
model InternResource {
  id           String             @id @default(cuid())
  title        String
  r2Key        String             @unique @map("r2_key")
  kind         InternResourceKind
  mime         String
  sizeBytes    Int                @map("size_bytes")
  uploadedById String             @map("uploaded_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  uploadedBy User @relation(fields: [uploadedById], references: [email], onDelete: Cascade)

  @@index([createdAt])
  @@map("intern_resources")
}
