generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js tables for magic link verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// UNIFIED USER MODEL
// ============================================================================

enum UserRole {
  dev
  admin
  manager
  member
}

model User {
  email        String   @id
  uid          String   @unique @default(uuid())
  name         String
  role         UserRole @default(member)
  passwordHash String?  @map("password_hash")
  profile      Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  managerProfile    ManagerProfile?
  activityManagers  ActivityManager[]
  activityUpdates   ActivityUpdate[]
  waivers           UserWaiver[]
  registrations     Registration[]
  flags             UserFlag[]          @relation("flaggedUser")
  issuedFlags       UserFlag[]          @relation("flagIssuer")
  promotionRequests PromotionRequest[]

  @@index([role])
  @@map("users")
}

model ManagerProfile {
  userEmail   String    @id @map("user_email")
  tag         String    @unique
  intern      Boolean   @default(true)
  internSince DateTime? @map("intern_since")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("manager_profiles")
}

// ============================================================================
// FLAG / BAN SYSTEM
// ============================================================================

enum FlagType {
  yellow
  red
}

model UserFlag {
  id         String   @id @default(uuid())
  userEmail  String   @map("user_email")
  activityId String   @map("activity_id")
  flagType   FlagType @map("flag_type")
  reason     String?
  issuedBy   String   @map("issued_by")
  issuedAt   DateTime @default(now()) @map("issued_at")

  user     User     @relation("flaggedUser", fields: [userEmail], references: [email], onDelete: Cascade)
  issuer   User     @relation("flagIssuer", fields: [issuedBy], references: [email], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userEmail])
  @@index([issuedAt])
  @@map("user_flags")
}

// ============================================================================
// WAIVERS
// ============================================================================

enum WaiverStatus {
  approved
  expiring
  expired
}

model UserWaiver {
  fileId        String       @id @map("file_id")
  userEmail     String       @map("user_email")
  signedAt      DateTime     @default(now()) @map("signed_at")
  status        WaiverStatus @default(approved)
  signedVersion Int?         @map("signed_version")
  signedName    String?      @map("signed_name")

  user User @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@map("user_waivers")
}

model WaiverTemplate {
  id         String   @id @default(uuid())
  version    Int      @unique @default(autoincrement())
  r2Key      String   @map("r2_key")
  filename   String
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy String   @map("uploaded_by")

  @@map("waiver_templates")
}

// ============================================================================
// ACTIVITIES
// ============================================================================

enum ActivityStatus {
  open
  closed
  completed
  cancelled
}

model Activity {
  id                  String         @id @default(uuid())
  title               String
  description         String
  coverImgId          String         @map("cover_img_id")
  deadline            DateTime
  date                DateTime
  capacity            Int
  maximumRegistration Int?           @map("maximum_registration")
  metadata            Json?          @db.JsonB
  status              ActivityStatus @default(open)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  activityManagers ActivityManager[]
  registrations    Registration[]
  updates          ActivityUpdate[]
  flags            UserFlag[]

  @@index([status])
  @@index([deadline])
  @@index([date])
  @@map("activities")
}

// ============================================================================
// ACTIVITY RELATIONSHIPS
// ============================================================================

enum ActivityManagerRole {
  manager
  comanager
}

enum ActivityManagerStatus {
  invited
  confirmed
  declined
}

model ActivityManager {
  activityId  String                @map("activity_id")
  userEmail   String                @map("user_email")
  role        ActivityManagerRole
  status      ActivityManagerStatus @default(confirmed)
  invitedAt   DateTime              @default(now()) @map("invited_at")
  respondedAt DateTime?             @map("responded_at")
  token       String?               @unique

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([role])
  @@index([status])
  @@map("activity_managers")
}

enum RegistrationStatus {
  registered
  registration_confirmed
  attended
  absent
}

model Registration {
  activityId   String             @map("activity_id")
  userEmail    String             @map("user_email")
  status       RegistrationStatus @default(registered)
  registeredAt DateTime           @default(now()) @map("registered_at")
  confirmedAt  DateTime?          @map("confirmed_at")
  notes        String?
  formData     Json?              @map("form_data") @db.JsonB
  pendingFlag       String?            @map("pending_flag")
  pendingFlagReason String?            @map("pending_flag_reason")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@id([activityId, userEmail])
  @@index([activityId])
  @@index([userEmail])
  @@index([status])
  @@map("registrations")
}

model ActivityUpdate {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  title      String
  content    String?
  postedBy   String   @map("posted_by")
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [postedBy], references: [email])

  @@index([activityId])
  @@index([createdAt])
  @@map("activity_updates")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

enum PromotionType {
  member_to_intern
  intern_to_qualified
}

enum PromotionStatus {
  pending
  pending_admin_review
  approved
  rejected
  expired
}

model PromotionRequest {
  id              String          @id @default(uuid())
  userEmail       String          @map("user_email")
  type            PromotionType
  status          PromotionStatus @default(pending)
  applicationText String?         @map("application_text")
  requestedAt     DateTime        @default(now()) @map("requested_at")
  expiresAt       DateTime        @map("expires_at")
  resolvedAt      DateTime?       @map("resolved_at")

  user  User              @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  votes PromotionVote[]

  @@index([userEmail])
  @@index([status])
  @@index([expiresAt])
  @@map("promotion_requests")
}

model PromotionVote {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  voterEmail String   @map("voter_email")
  approved   Boolean?
  reason     String?
  votedAt    DateTime? @map("voted_at")
  token      String   @unique

  request PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, voterEmail])
  @@index([requestId])
  @@index([token])
  @@map("promotion_votes")
}

// ============================================================================
// SYSTEM
// ============================================================================

enum AuditEntityType {
  user
  activity
  registration
}

enum AuditAction {
  create
  update
  delete
  status_change
}

model AuditLog {
  id          String          @id @default(uuid())
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  action      AuditAction
  performedBy String?         @map("performed_by")
  oldValues   Json?           @map("old_values") @db.JsonB
  newValues   Json?           @map("new_values") @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model AppSettings {
  key   String @id
  value String

  @@map("app_settings")
}
